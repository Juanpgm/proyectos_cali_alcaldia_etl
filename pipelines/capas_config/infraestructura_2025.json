{
  "shapefile_path": "app_inputs/unidades_proyecto_input/Reporte_gobierno_GO2025.shp",

  "columns_to_drop": [
    "Id", "COMUNA", "BARRIO", "Barrio_1", "Comuna_1",
    "X_INICIA_1", "Y_INICIA_1", "X_FINAL_1", "Y_FINAL_1",
    "X_inicial", "Y_inicial", "X_final", "Y_final",
    "FID_1", "Id_1", "Direcci_1",
    "F__CARRILE", "VALOR_BASE", "ESTADO_REP", "LONGITUD_V",
    "Nompre_BP", "VALOR_METR", "MES", "Longitud",
    "Tipo_Int_1", "Tipo_Int_2", "Tipo_Mezcl", "ANCHO__VIA",
    "JERARQUIZ", "Longitud_1"
  ],

  "column_mapping": {
    "MEZCLA": "nombre_up_detalle",
    "Tipo_Infra": "nombre_up",
    "FECHA_INCI": "fecha_inicio",
    "FECHA_FIN": "fecha_fin",
    "TIPO_INTER": "tipo_intervencion",
    "BPIN": "bpin",
    "BP_CALCULA": "bp",
    "VALOR_INTE": "presupuesto_base",
    "METROS": "cantidad",
    "ESTADO": "estado",
    "Año": "anio",
    "F__AVANCE": "avance_obra",
    "Tipo_Grupo": "identificador",
    "DIRECCIÓN": "direccion"
  },

  "default_values": {
    "unidad": "m",
    "tipo_equipamiento": "Vías",
    "clase_up": "Obra vial",
    "nombre_centro_gestor": "Secretaría de Infraestructura",
    "referencia_proceso": null,
    "referencia_contrato": null,
    "fuente_financiacion": null,
    "fecha_inauguracion": null,
    "plataforma": null,
    "url_proceso": null,
    "descripcion_intervencion": null,
    "observaciones": null
  },

  "text_capitalize_columns": [
    "tipo_intervencion", "nombre_up", "nombre_up_detalle",
    "identificador", "estado", "direccion"
  ],

  "replacements": {
    "nombre_up": {
      "No Reportado": "Vía Local",
      "Via": "Vía"
    }
  },

  "numeric_cleaning": {
    "avance_obra": {
      "strip": ["%"],
      "comma_to_dot": true
    },
    "presupuesto_base": {
      "strip": ["$", "."],
      "comma_to_dot": true
    },
    "cantidad": {
      "strip": [],
      "comma_to_dot": false
    }
  },

  "force_values": {
    "estado": "Terminado"
  },

  "fillna_values": {
    "tipo_intervencion": "Pavimento"
  },

  "anio_field": "anio",

  "needs_crs_transform": true
}
